@{
    ViewData["Title"] = "User Login - SmartStock Management System";
}

<!DOCTYPE html>
<html lang="en-us">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
          rel="stylesheet"
          crossorigin="anonymous" />

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"
          rel="stylesheet"
          crossorigin="anonymous" />

    <title>@ViewData["Title"]</title>
</head>

<body class="bg-light">
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-5 col-xl-4">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-primary text-white text-center py-3">
                        <h4 class="mb-0">
                            <i class="fas fa-sign-in-alt me-2"></i>
                            Inventory Management System
                        </h4>
                        <small class="opacity-75">Login</small>
                    </div>

                    <div class="card-body p-4">

                        <!-- ✅ 顯示後端 ModelState 全局錯誤（例如 Invalid username or password） -->
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger" role="alert">
                                @Html.ValidationSummary(true)
                            </div>
                        }

                        <form asp-action="Login" method="post" id="loginForm" novalidate>
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label for="Username" class="form-label">Username</label>
                                <input type="text"
                                       class="form-control @(ViewData.ModelState.ContainsKey("username") ? "is-invalid" : "")"
                                       id="Username"
                                       name="username"
                                       placeholder="Please input the username"
                                       autocomplete="username"
                                       required />

                                <div class="invalid-feedback">
                                    @Html.ValidationMessage("username")
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="Password" class="form-label">Password</label>
                                <input type="password"
                                       class="form-control @(ViewData.ModelState.ContainsKey("password") ? "is-invalid" : "")"
                                       id="Password"
                                       name="password"
                                       placeholder="Please input the password"
                                       autocomplete="current-password"
                                       required />

                                <div class="invalid-feedback">
                                    @Html.ValidationMessage("password")
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="form-check">
                                    <input type="checkbox"
                                           class="form-check-input"
                                           id="RememberMe"
                                           name="rememberMe" />
                                    <label class="form-check-label" for="RememberMe">Remember me</label>
                                </div>

                                <a href="#" class="small text-decoration-none">Forgot password?</a>
                            </div>

                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fas fa-sign-in-alt me-2"></i> Login
                            </button>

                            <div class="mt-3 text-center">
                                <small class="text-muted">
                                    No account?
                                    <a asp-action="Register" asp-controller="Account" class="text-decoration-none">
                                        Register
                                    </a>
                                </small>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="text-center mt-3">
                    <small class="text-muted">© SmartStock</small>
                </div>
            </div>
        </div>
    </div>

    <!-- ✅ Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            crossorigin="anonymous"></script>

    <!-- ✅ 只做「Bootstrap 友善驗證」，不跳 alert -->
    <script>
        (function () {
            const form = document.getElementById('loginForm');
            if (!form) return;

            form.addEventListener('submit', function (e) {
                if (!form.checkValidity()) {
                    e.preventDefault();
                    e.stopPropagation();
                }
                form.classList.add('was-validated');
            });
        })();
    </script>
</body>
</html>